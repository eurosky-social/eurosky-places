# Postgres + PostGIS (compose.yml exposes it on 127.0.0.1:5433)
DATABASE_URL=postgres://places:places@127.0.0.1:5433/places
# Tests drop and recreate this database on every run
DATABASE_URL_TEST=postgres://places:places@127.0.0.1:5433/places_test

HOST=127.0.0.1
PORT=3000

# Hugging Face token with access to foursquare/fsq-os-places (the dataset is gated).
# Falls back to ~/.huggingface/token when unset.
HF_TOKEN=

# Shared secret (32+ characters) for /internal/* — the check-in listener and admin
# overrides. Unset disables those routes.
INTERNAL_TOKEN=
# Postgres connections per service process (default 20)
PG_POOL_MAX=20

# Loader only. DuckDB uses up to 80% of RAM by default; cap it where Postgres runs on the
# same machine (e.g. 16GB), and send its spill files to a disk with room.
DUCKDB_MEMORY_LIMIT=
DUCKDB_TEMP_DIRECTORY=
