# Postgres + PostGIS (compose.yml exposes it on 127.0.0.1:5433)
DATABASE_URL=postgres://places:places@127.0.0.1:5433/places
# Tests drop and recreate this database on every run
DATABASE_URL_TEST=postgres://places:places@127.0.0.1:5433/places_test

HOST=127.0.0.1
PORT=3000

# Hugging Face token with access to foursquare/fsq-os-places (the dataset is gated).
# Falls back to ~/.huggingface/token when unset.
HF_TOKEN=
